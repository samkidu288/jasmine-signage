# PORT: Port server digital signage (di atas port 3006, gunakan 3007)
PORT=3007

# NODE_ENV: production saat dijalankan di VPS
NODE_ENV=production

# GEMINI_API_KEY: Opsional / runtime secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL aplikasi
APP_URL="https://adminsignage.jasminelaundry.my.id"
